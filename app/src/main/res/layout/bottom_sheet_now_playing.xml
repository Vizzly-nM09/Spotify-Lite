<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@color/stroke_subtle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/work_sans_medium"
            android:text="@string/now_playing_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/btnCloseSheet"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_close_player"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/bg_surface_elevated"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/stroke_subtle"
        app:strokeWidth="1dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSheetArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_artwork_placeholder"
            android:contentDescription="@string/cd_track_artwork"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.SpotifyLite.Artwork20" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:ellipsize="end"
        android:fontFamily="@font/outfit_semibold"
        android:letterSpacing="-0.02"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        tools:text="The Scientist" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSheetArtist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/work_sans_regular"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            tools:text="Coldplay" />

        <TextView
            android:id="@+id/tvSheetSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge_accent"
            android:fontFamily="@font/work_sans_medium"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/accent_on_container"
            android:textSize="11sp"
            tools:text="YouTube" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/sliderProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:valueFrom="0.0"
        android:valueTo="100.0"
        app:haloRadius="14dp"
        app:labelBehavior="gone"
        app:thumbColor="@color/accent_primary"
        app:thumbHeight="14dp"
        app:thumbTrackGapSize="0dp"
        app:thumbWidth="14dp"
        app:trackColorActive="@color/accent_primary"
        app:trackColorInactive="@color/stroke_subtle"
        app:trackHeight="4dp"
        app:trackStopIndicatorSize="0dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvElapsedTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/work_sans_medium"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="1:12" />

        <TextView
            android:id="@+id/tvTotalTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/work_sans_medium"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="5:09" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnSheetShuffle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_shuffle"
            android:padding="12dp"
            android:src="@drawable/ic_shuffle"
            app:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/btnSheetPrev"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_previous_track"
            android:padding="12dp"
            android:src="@drawable/ic_skip_previous"
            app:tint="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSheetPlayPause"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@string/cd_play_pause"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/accent_primary"
            app:cornerRadius="32dp"
            app:icon="@drawable/ic_play"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp"
            app:iconTint="@color/accent_on_primary" />

        <ImageButton
            android:id="@+id/btnSheetNext"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_next_track"
            android:padding="12dp"
            android:src="@drawable/ic_skip_next"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnSheetRepeat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cd_repeat"
            android:padding="12dp"
            android:src="@drawable/ic_repeat"
            app:tint="@color/text_secondary" />
    </LinearLayout>
</LinearLayout>
